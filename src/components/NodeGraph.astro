---
// NodeGraph.astro: Single reflowing workflow simulation component on ink panel
---

<div class="workflow-simulator ink-panel" id="workflow-simulator">
  <div class="panel-header hairline-bottom">
    <div class="panel-meta">
      <span class="panel-tag mono">[DIAGRAM 01]</span>
      <span class="panel-title mono">INBOUND INGEST WORKFLOW GRAPH</span>
    </div>
    <div class="panel-status">
      <span class="stamp-simulation mono">[STATUS: SIMULATION ONLY // NOT A LIVE RUN]</span>
    </div>
  </div>

  <div class="simulator-body">
    <!-- Interactive Canvas Area -->
    <div class="graph-canvas-wrap">
      <!-- SVG Connecting Wires (Desktop Canvas) -->
      <svg class="wires-canvas" viewBox="0 0 640 180" fill="none" preserveAspectRatio="none" aria-hidden="true">
        <!-- Background guide hairlines -->
        <path d="M 120 90 L 220 90" stroke="var(--graphite)" stroke-width="2" class="wire-base" />
        <path d="M 280 90 L 380 90" stroke="var(--graphite)" stroke-width="2" class="wire-base" />
        <path d="M 440 90 L 540 90" stroke="var(--graphite)" stroke-width="2" class="wire-base" />

        <!-- Animated Amber Packet Paths -->
        <path d="M 120 90 L 220 90" stroke="var(--signal-amber)" stroke-width="3" class="wire-active wire-seg-1" />
        <path d="M 280 90 L 380 90" stroke="var(--signal-amber)" stroke-width="3" class="wire-active wire-seg-2" />
        <path d="M 440 90 L 540 90" stroke="var(--signal-amber)" stroke-width="3" class="wire-active wire-seg-3" />
      </svg>

      <!-- Single Semantic Ordered List of Workflow Nodes -->
      <ol class="nodes-list" aria-label="Workflow execution sequence">
        <li class="node-item" id="node-1" data-step="1">
          <div class="node-box">
            <span class="node-step mono">01</span>
            <span class="node-name">Webhook</span>
            <span class="node-detail mono">POST /ingress</span>
          </div>
        </li>

        <li class="node-arrow" aria-hidden="true">
          <span class="arrow-glyph mono">→</span>
        </li>

        <li class="node-item" id="node-2" data-step="2">
          <div class="node-box">
            <span class="node-step mono">02</span>
            <span class="node-name">Classify</span>
            <span class="node-detail mono">agent prompt</span>
          </div>
        </li>

        <li class="node-arrow" aria-hidden="true">
          <span class="arrow-glyph mono">→</span>
        </li>

        <li class="node-item" id="node-3" data-step="3">
          <div class="node-box">
            <span class="node-step mono">03</span>
            <span class="node-name">Write to CRM</span>
            <span class="node-detail mono">upsert customer</span>
          </div>
        </li>

        <li class="node-arrow" aria-hidden="true">
          <span class="arrow-glyph mono">→</span>
        </li>

        <li class="node-item" id="node-4" data-step="4">
          <div class="node-box">
            <span class="node-step mono">04</span>
            <span class="node-name">Notify</span>
            <span class="node-detail mono">ops alert</span>
          </div>
        </li>
      </ol>

      <!-- Simulation Trigger Button -->
      <div class="canvas-controls">
        <button type="button" class="btn btn-primary run-button" id="run-simulation-btn" aria-controls="sim-payload-output">
          <span class="btn-text">Run Simulation</span>
        </button>
        <span class="sim-status mono" id="sim-status-announcer" aria-live="polite">Idle. Ready to simulate.</span>
      </div>
    </div>

    <!-- Monospace Payload Inspector -->
    <div class="inspector-wrap">
      <div class="inspector-header hairline-bottom">
        <span class="inspector-tab mono active">PAYLOAD INSPECTOR</span>
        <span class="inspector-latency mono" id="sim-latency">RUNTIME: 0ms</span>
      </div>

      <div class="inspector-panes">
        <div class="payload-block">
          <span class="block-title mono">SAMPLE INPUT JSON</span>
          <pre class="json-code mono" id="sim-payload-input"><code>&#123;
  "event": "inbound_enquiry",
  "sender": "visitor@example.com",
  "project": "web_refactor",
  "timestamp": "2026-10-10T12:00:00Z"
&#125;</code></pre>
        </div>

        <div class="payload-block hairline-top">
          <span class="block-title mono">SAMPLE OUTPUT JSON</span>
          <pre class="json-code mono" id="sim-payload-output"><code>&#123;
  "status": "ready",
  "classification": null,
  "crmRecordId": null,
  "dispatched": false
&#125;</code></pre>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .ink-panel {
    background-color: var(--ink);
    color: var(--paper);
    border: 1px solid var(--graphite);
    border-radius: 2px;
    position: relative;
    overflow: hidden;
  }

  .panel-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    background-color: rgba(42, 45, 38, 0.4);
    border-bottom: 1px solid var(--graphite);
    gap: 0.5rem;
  }

  .panel-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .panel-tag {
    font-size: 0.6875rem;
    color: var(--signal-amber);
  }

  .panel-title {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--paper);
    letter-spacing: 0.05em;
  }

  .stamp-simulation {
    font-size: 0.6875rem;
    color: var(--signal-amber);
    border: 1px solid var(--signal-amber);
    padding: 0.15rem 0.45rem;
    border-radius: 2px;
    background-color: rgba(245, 163, 0, 0.08);
  }

  .simulator-body {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 900px) {
    .simulator-body {
      grid-template-columns: 1.35fr 1fr;
    }
  }

  /* Canvas styling */
  .graph-canvas-wrap {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    border-bottom: 1px solid var(--graphite);
  }

  @media (min-width: 900px) {
    .graph-canvas-wrap {
      border-bottom: none;
      border-right: 1px solid var(--graphite);
    }
  }

  .wires-canvas {
    display: none;
  }

  @media (min-width: 768px) {
    .wires-canvas {
      display: block;
      position: absolute;
      top: 2rem;
      left: 1.5rem;
      right: 1.5rem;
      width: calc(100% - 3rem);
      height: 120px;
      pointer-events: none;
      z-index: 1;
    }
  }

  .wire-base {
    opacity: 0.35;
  }

  .wire-active {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .wire-active.animating {
    opacity: 1;
    animation: drawPacket 0.6s linear forwards;
  }

  @keyframes drawPacket {
    0% {
      stroke-dashoffset: 100;
    }
    100% {
      stroke-dashoffset: 0;
    }
  }

  /* Reflowing semantic nodes list */
  .nodes-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
    z-index: 2;
  }

  @media (min-width: 768px) {
    .nodes-list {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 1.5rem 0;
    }
  }

  .node-item {
    flex: 1;
    display: flex;
  }

  .node-box {
    width: 100%;
    background-color: var(--ink);
    border: 1px solid var(--graphite);
    border-radius: 2px;
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }

  .node-item.active .node-box {
    border-color: var(--signal-amber);
    background-color: rgba(245, 163, 0, 0.05);
  }

  .node-item.completed .node-box {
    border-color: var(--verdigris);
  }

  .node-step {
    font-size: 0.625rem;
    color: var(--rule);
  }

  .node-item.active .node-step {
    color: var(--signal-amber);
  }

  .node-name {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--paper);
  }

  .node-detail {
    font-size: 0.6875rem;
    color: var(--rule);
  }

  .node-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--graphite);
  }

  @media (min-width: 768px) {
    .node-arrow {
      display: none; /* SVG canvas handles wires on desktop */
    }
  }

  .arrow-glyph {
    font-size: 1rem;
    transform: rotate(90deg);
  }

  @media (min-width: 768px) {
    .arrow-glyph {
      transform: none;
    }
  }

  .canvas-controls {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .run-button {
    font-size: 0.875rem;
    padding: 0.6rem 1.25rem;
  }

  .sim-status {
    font-size: 0.75rem;
    color: var(--paper);
    opacity: 0.8;
  }

  /* Inspector styling */
  .inspector-wrap {
    background-color: rgba(17, 19, 15, 0.95);
    display: flex;
    flex-direction: column;
  }

  .inspector-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--graphite);
    background-color: rgba(42, 45, 38, 0.2);
  }

  .inspector-tab {
    font-size: 0.6875rem;
    color: var(--paper);
    letter-spacing: 0.05em;
  }

  .inspector-latency {
    font-size: 0.6875rem;
    color: var(--signal-amber);
  }

  .inspector-panes {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .payload-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .block-title {
    font-size: 0.6875rem;
    color: var(--rule);
    letter-spacing: 0.05em;
  }

  .json-code {
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--paper);
    background-color: rgba(42, 45, 38, 0.4);
    padding: 0.75rem;
    border-radius: 2px;
    border: 1px solid var(--graphite);
    overflow-x: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .wire-active.animating {
      animation: none !important;
      stroke-dashoffset: 0 !important;
      opacity: 1 !important;
    }
  }
</style>

<script>
  // Client-side simulation logic
  const runBtn = document.getElementById('run-simulation-btn');
  const statusAnnouncer = document.getElementById('sim-status-announcer');
  const latencyDisplay = document.getElementById('sim-latency');
  const outputDisplay = document.getElementById('sim-payload-output');
  const nodes = [
    document.getElementById('node-1'),
    document.getElementById('node-2'),
    document.getElementById('node-3'),
    document.getElementById('node-4')
  ];

  let isRunning = false;

  if (runBtn) {
    runBtn.addEventListener('click', () => {
      if (isRunning) return;
      isRunning = true;
      runBtn.setAttribute('disabled', 'true');

      // Reset previous state
      nodes.forEach(n => {
        n?.classList.remove('active', 'completed');
      });

      if (statusAnnouncer) statusAnnouncer.textContent = 'Simulation initiated. Ingesting webhook...';
      if (latencyDisplay) latencyDisplay.textContent = 'RUNTIME: calculating...';

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const stepDuration = prefersReducedMotion ? 100 : 500;

      // Step 1: Webhook
      nodes[0]?.classList.add('active');

      setTimeout(() => {
        nodes[0]?.classList.remove('active');
        nodes[0]?.classList.add('completed');
        nodes[1]?.classList.add('active');
        if (statusAnnouncer) statusAnnouncer.textContent = 'Classifying enquiry with agent schema...';
      }, stepDuration);

      // Step 2: Classify
      setTimeout(() => {
        nodes[1]?.classList.remove('active');
        nodes[1]?.classList.add('completed');
        nodes[2]?.classList.add('active');
        if (statusAnnouncer) statusAnnouncer.textContent = 'Writing normalized record to CRM destination...';
      }, stepDuration * 2);

      // Step 3: Write to CRM
      setTimeout(() => {
        nodes[2]?.classList.remove('active');
        nodes[2]?.classList.add('completed');
        nodes[3]?.classList.add('active');
        if (statusAnnouncer) statusAnnouncer.textContent = 'Dispatching ops notification...';
      }, stepDuration * 3);

      // Step 4: Complete
      setTimeout(() => {
        nodes[3]?.classList.remove('active');
        nodes[3]?.classList.add('completed');

        if (statusAnnouncer) statusAnnouncer.textContent = 'Simulation complete. 4 nodes processed.';
        if (latencyDisplay) latencyDisplay.textContent = 'RUNTIME: 380ms estimate';

        if (outputDisplay) {
          outputDisplay.innerHTML = `<code>&#123;
  "status": "success_simulation",
  "classification": "high_priority_build",
  "crmRecordId": "rec_sim_8923",
  "dispatched": true,
  "executionSummary": "all nodes executed in simulation"
&#125;</code>`;
        }

        isRunning = false;
        runBtn.removeAttribute('disabled');
      }, stepDuration * 4);
    });
  }
</script>
