---
// RegistrationMarks.astro: Inline SVG corner crosshairs and technical border marks
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<div class={`registration-marks ${className}`} aria-hidden="true">
  <!-- Top Left Corner Crosshair -->
  <svg class="mark mark-tl" width="24" height="24" viewBox="0 0 24 24" fill="none">
    <line x1="12" y1="0" x2="12" y2="24" stroke="currentColor" stroke-width="1" />
    <line x1="0" y1="12" x2="24" y2="12" stroke="currentColor" stroke-width="1" />
    <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1" fill="none" />
  </svg>

  <!-- Top Right Corner Crosshair -->
  <svg class="mark mark-tr" width="24" height="24" viewBox="0 0 24 24" fill="none">
    <line x1="12" y1="0" x2="12" y2="24" stroke="currentColor" stroke-width="1" />
    <line x1="0" y1="12" x2="24" y2="12" stroke="currentColor" stroke-width="1" />
    <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1" fill="none" />
  </svg>

  <!-- Bottom Left Corner Crosshair -->
  <svg class="mark mark-bl" width="24" height="24" viewBox="0 0 24 24" fill="none">
    <line x1="12" y1="0" x2="12" y2="24" stroke="currentColor" stroke-width="1" />
    <line x1="0" y1="12" x2="24" y2="12" stroke="currentColor" stroke-width="1" />
    <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1" fill="none" />
  </svg>

  <!-- Bottom Right Corner Crosshair -->
  <svg class="mark mark-br" width="24" height="24" viewBox="0 0 24 24" fill="none">
    <line x1="12" y1="0" x2="12" y2="24" stroke="currentColor" stroke-width="1" />
    <line x1="0" y1="12" x2="24" y2="12" stroke="currentColor" stroke-width="1" />
    <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1" fill="none" />
  </svg>
</div>

<style>
  .registration-marks {
    pointer-events: none;
    position: absolute;
    inset: 0;
    overflow: hidden;
    color: var(--rule);
  }

  .mark {
    position: absolute;
    opacity: 0.85;
  }

  .mark-tl {
    top: 6px;
    left: 6px;
  }

  .mark-tr {
    top: 6px;
    right: 6px;
  }

  .mark-bl {
    bottom: 6px;
    left: 6px;
  }

  .mark-br {
    bottom: 6px;
    right: 6px;
  }
</style>
