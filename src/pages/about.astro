---
import BaseLayout from "../layouts/BaseLayout.astro";
import Stamp from "../components/Stamp.astro";
import { studioConfig } from "../data/config";
---

<BaseLayout
  title="Studio Philosophy | Protorev Digital"
  description="Operational architecture and engineering philosophy of Protorev Digital. A new studio with open reference blueprints."
  sheetNumber="04"
  totalSheets="06"
  sheetTitle="STUDIO SPECIFICATION: PHILOSOPHY"
>
  <article class="about-sheet hairline-bottom">
    <div class="sheet-container">
      <div class="about-header hairline-bottom">
        <div class="badge-row">
          <span class="sheet-tag mono">STUDIO DISCLOSURE</span>
          <Stamp text="ACTIVE SPECIFICATION" variant="draft" />
        </div>
        <h1 class="about-title">
          Engineering Philosophy and <em>Practice</em>
        </h1>
        <p class="about-summary">
          {studioConfig.studioName} is a new digital engineering studio. We operate without fabricated histories, vanity metrics, or stock representations.
        </p>
      </div>

      <div class="about-grid">
        <div class="about-main-col">
          <div class="about-section">
            <h2 class="section-title label-mono">CORE OPERATING PREMISE</h2>
            <p class="body-text">
              Most digital service websites rely on inflated metrics, vague marketing adjectives, and fabricated case studies. We take the inverse approach. Because this is a newly formed studio with no prior client work published, every artifact on this domain is an open reference blueprint designed for direct technical inspection.
            </p>
            <p class="body-text">
              You can review our underlying markup, inspect simulation logs, test failure recovery modes, and review deterministic workflows before entering any commercial discussion.
            </p>
          </div>

          <div class="about-section hairline-top">
            <h2 class="section-title label-mono">THE FOUR DISCIPLINES</h2>
            <div class="disciplines-grid">
              <div class="discipline-card ink-border">
                <span class="disc-num mono">01</span>
                <h3 class="disc-title">Web Architecture</h3>
                <p class="disc-text">
                  Static markup compiled for rapid response times. Built with standard CSS custom properties and zero unnecessary client script payload.
                </p>
              </div>

              <div class="discipline-card ink-border">
                <span class="disc-num mono">02</span>
                <h3 class="disc-title">Technical SEO</h3>
                <p class="disc-text">
                  Automated entity graphs, clean crawl hierarchies, and programmatic verification ensuring search engines index content without friction.
                </p>
              </div>

              <div class="discipline-card ink-border">
                <span class="disc-num mono">03</span>
                <h3 class="disc-title">Marketing Ops</h3>
                <p class="disc-text">
                  Resilient webhook conduits connecting public capture forms directly to backend customer records with verified privacy compliance.
                </p>
              </div>

              <div class="discipline-card ink-border">
                <span class="disc-num mono">04</span>
                <h3 class="disc-title">Automation</h3>
                <p class="disc-text">
                  Self hosted n8n workflow routines, dead letter alert queues, and structured classification prompts with strict output schema validation.
                </p>
              </div>
            </div>
          </div>

          <div class="about-section hairline-top">
            <h2 class="section-title label-mono">ACCURACY AND REVISION POLICY</h2>
            <p class="body-text">
              Every detail on this domain is audited against our truth constraints. Unknown items are explicitly registered as unconfirmed rather than assumed. Changes to studio capabilities are logged in the public sheet revision history.
            </p>
          </div>
        </div>

        <aside class="about-sidebar-col hairline-left">
          <div class="studio-facts-card ink-border">
            <div class="card-header hairline-bottom">
              <span class="card-title label-mono">STUDIO REGISTRY</span>
            </div>
            <div class="card-body">
              <div class="fact-row">
                <span class="fact-key label-mono">STUDIO NAME</span>
                <span class="fact-val mono">{studioConfig.studioName}</span>
              </div>
              <div class="fact-row hairline-top">
                <span class="fact-key label-mono">CURRENT STATUS</span>
                <span class="fact-val mono">Active Public Spec (Rev A)</span>
              </div>
              <div class="fact-row hairline-top">
                <span class="fact-key label-mono">COMMERCIAL MODEL</span>
                <span class="fact-val mono">Fixed Scope Technical Pilot</span>
              </div>
              <div class="fact-row hairline-top">
                <span class="fact-key label-mono">LOCALE COORDINATE</span>
                <span class="fact-val mono">{studioConfig.city}</span>
              </div>
              <div class="fact-row hairline-top">
                <span class="fact-key label-mono">PRIMARY INGRESS</span>
                <span class="fact-val mono">{studioConfig.contactEmail}</span>
              </div>
            </div>
          </div>

          <div class="action-card ink-border">
            <div class="card-header hairline-bottom">
              <span class="card-title label-mono">EVALUATION</span>
            </div>
            <div class="card-body">
              <p class="action-text">
                Review our pilot framework or dispatch an enquiry to discuss your architecture requirements.
              </p>
              <a href="/contact" class="btn btn-primary action-btn">
                Initiate Contact Node
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .about-sheet {
    padding: 3rem 0;
    background-color: var(--paper);
  }

  .about-header {
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
  }

  .badge-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .sheet-tag {
    font-size: 0.75rem;
    color: var(--graphite);
    letter-spacing: 0.08em;
  }

  .about-title {
    font-size: 2.5rem;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: var(--ink);
  }

  .about-summary {
    font-size: 1.125rem;
    color: var(--graphite);
    max-width: 800px;
    line-height: 1.6;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: 1.8fr 1fr;
    }
  }

  .about-main-col {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .about-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1.5rem;
  }

  .about-section:first-child {
    padding-top: 0;
  }

  .section-title {
    color: var(--graphite);
  }

  .body-text {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--graphite);
  }

  .disciplines-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  @media (min-width: 640px) {
    .disciplines-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .discipline-card {
    padding: 1.25rem;
    background-color: var(--paper-shade);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .disc-num {
    font-size: 0.75rem;
    color: var(--graphite);
  }

  .disc-title {
    font-size: 1.0625rem;
    color: var(--ink);
    line-height: 1.3;
  }

  .disc-text {
    font-size: 0.8125rem;
    color: var(--graphite);
    line-height: 1.5;
  }

  .about-sidebar-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-left: 0;
  }

  @media (min-width: 900px) {
    .about-sidebar-col {
      padding-left: 2rem;
    }
  }

  .studio-facts-card,
  .action-card {
    background-color: var(--paper);
  }

  .card-header {
    padding: 0.75rem 1rem;
    background-color: var(--paper-shade);
  }

  .card-title {
    color: var(--ink);
  }

  .card-body {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .fact-row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-top: 0.75rem;
  }

  .fact-row:first-child {
    padding-top: 0;
  }

  .fact-key {
    color: var(--graphite);
  }

  .fact-val {
    font-size: 0.8125rem;
    color: var(--ink);
    font-weight: 500;
  }

  .action-text {
    font-size: 0.875rem;
    color: var(--graphite);
    line-height: 1.5;
  }

  .action-btn {
    width: 100%;
    margin-top: 0.5rem;
  }
</style>
