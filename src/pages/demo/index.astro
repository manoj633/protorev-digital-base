---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Stamp from "../../components/Stamp.astro";

const conceptDemos = [
  {
    name: "Calmora",
    slug: "Calmora",
    type: "Wellness Studio Interface",
    summary: "Exploratory design build focusing on minimal palette and organic typography."
  },
  {
    name: "Aurum",
    slug: "Aurum",
    type: "Commerce Experience",
    summary: "Visual demonstration exploring luxury e-commerce layout patterns and product cards."
  },
  {
    name: "Lumiere",
    slug: "Lumiere",
    type: "Editorial Narrative",
    summary: "Exploration in editorial hierarchy, long form readability, and fluid grid structure."
  },
  {
    name: "Meher",
    slug: "Meher",
    type: "Artisanal Studio",
    summary: "Visual exploration for artisanal portfolio presentation and gallery navigation."
  }
];
---

<BaseLayout
  title="Concept Archive | Protorev Digital"
  description="Archived exploratory design prototypes and layout studies."
  sheetNumber="03"
  totalSheets="06"
  sheetTitle="ARCHIVE: CONCEPT EXPLORATIONS"
  noindex={true}
>
  <article class="demo-sheet hairline-bottom">
    <div class="sheet-container">
      <div class="demo-header hairline-bottom">
        <div class="badge-row">
          <span class="sheet-tag mono">PROTOTYPE ARCHIVE</span>
          <Stamp text="CONCEPT ONLY" variant="draft" />
          <span class="robots-flag mono">[DIRECTIVE: NOINDEX]</span>
        </div>
        <h1 class="demo-title">
          Concept Build <em>Archive</em>
        </h1>
        <p class="demo-summary">
          These visual studies are preserved reference concepts. They represent interface styling experiments and are excluded from search crawl indexes.
        </p>
      </div>

      <div class="demo-grid">
        {conceptDemos.map((demo) => (
          <div class="demo-card ink-border">
            <div class="card-header hairline-bottom">
              <span class="demo-type mono">{demo.type}</span>
              <Stamp text="ARCHIVED" variant="draft" />
            </div>

            <div class="card-body">
              <h2 class="card-name">{demo.name}</h2>
              <p class="card-desc">{demo.summary}</p>

              <div class="card-footer hairline-top">
                <a href={`/demo/${demo.slug}/`} class="launch-link mono" target="_blank" rel="noopener">
                  <span>Launch Concept Build</span>
                  <span class="arrow">→</span>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .demo-sheet {
    padding: 3rem 0;
    background-color: var(--paper);
  }

  .demo-header {
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
  }

  .badge-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .sheet-tag {
    font-size: 0.75rem;
    color: var(--graphite);
    letter-spacing: 0.08em;
  }

  .robots-flag {
    font-size: 0.6875rem;
    color: var(--graphite);
  }

  .demo-title {
    font-size: 2.5rem;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: var(--ink);
  }

  .demo-summary {
    font-size: 1.125rem;
    color: var(--graphite);
    max-width: 800px;
    line-height: 1.6;
  }

  .demo-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .demo-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .demo-card {
    background-color: var(--paper);
    display: flex;
    flex-direction: column;
  }

  .card-header {
    padding: 0.75rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: var(--paper-shade);
  }

  .demo-type {
    font-size: 0.6875rem;
    color: var(--graphite);
  }

  .card-body {
    padding: 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
  }

  .card-name {
    font-size: 1.375rem;
    color: var(--ink);
  }

  .card-desc {
    font-size: 0.875rem;
    color: var(--graphite);
    line-height: 1.5;
    margin-bottom: auto;
  }

  .card-footer {
    margin-top: 1rem;
    padding-top: 0.75rem;
  }

  .launch-link {
    font-size: 0.8125rem;
    color: var(--ink);
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-weight: 500;
  }

  .launch-link:hover {
    color: var(--vermilion);
  }

  .arrow {
    transition: transform 0.15s ease;
  }

  .launch-link:hover .arrow {
    transform: translateX(4px);
  }
</style>
