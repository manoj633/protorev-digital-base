---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import Stamp from "../../components/Stamp.astro";

export async function getStaticPaths() {
  const usecases = await getCollection("usecases");
  return usecases.map((entry) => ({
    params: { id: entry.data.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
---

<BaseLayout
  title={`${data.id}: ${data.title} | Protorev Digital`}
  description={data.summary}
  sheetNumber="03"
  totalSheets="06"
  sheetTitle={`REFERENCE SPECIFICATION: ${data.id}`}
>
  <article class="usecase-detail-sheet hairline-bottom">
    <div class="sheet-container">
      <div class="nav-breadcrumbs">
        <a href="/usecases" class="back-link mono">← Return to Reference Builds Table</a>
      </div>

      <div class="detail-header hairline-bottom">
        <div class="header-tags">
          <span class="sheet-id mono">{data.id}</span>
          <Stamp text={data.status} variant={data.status === "SIMULATED" ? "simulated" : "draft"} />
          <span class="notice-tag mono">[OPEN REFERENCE BLUEPRINT]</span>
        </div>

        <h1 class="usecase-heading">
          {data.title}
        </h1>
        <p class="usecase-lead">
          {data.summary}
        </p>
      </div>

      <div class="detail-grid">
        <div class="content-col">
          <div class="prose-body">
            <Content />
          </div>
        </div>

        <aside class="sidebar-col hairline-left">
          <div class="spec-sidebar-card ink-border">
            <div class="card-header hairline-bottom">
              <span class="card-title label-mono">EXECUTION PARAMETERS</span>
            </div>

            <div class="card-body">
              <div class="param-group">
                <span class="param-label label-mono">TRIGGER</span>
                <span class="param-value mono">{data.trigger}</span>
              </div>

              <div class="param-group hairline-top">
                <span class="param-label label-mono">STACK</span>
                <span class="param-value mono">{data.stack}</span>
              </div>

              <div class="param-group hairline-top">
                <span class="param-label label-mono">RUNTIME ESTIMATE</span>
                <span class="param-value mono">{data.runtime}</span>
              </div>

              <div class="param-group hairline-top">
                <span class="param-label label-mono">COST PER RUN</span>
                <span class="param-value mono">{data.costPerRun}</span>
              </div>

              {data.estimateBasis && (
                <div class="param-group hairline-top">
                  <span class="param-label label-mono">ESTIMATE BASIS</span>
                  <span class="param-basis mono">{data.estimateBasis}</span>
                </div>
              )}

              <div class="param-group hairline-top">
                <span class="param-label label-mono">WORKFLOW EXPORT</span>
                {data.workflowFile ? (
                  <a href={data.workflowFile} class="download-btn mono" download>
                    Download n8n JSON
                  </a>
                ) : (
                  <span class="param-note mono">Workflow file: not yet published</span>
                )}
              </div>
            </div>
          </div>

          <div class="failure-card ink-border">
            <div class="card-header hairline-bottom">
              <span class="card-title label-mono">IDENTIFIED FAILURE MODES</span>
            </div>
            <ul class="failure-list mono">
              {data.failureModes.map((mode: string) => (
                <li class="failure-item">
                  <span class="warn-bullet">•</span>
                  <span>{mode}</span>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .usecase-detail-sheet {
    padding: 3rem 0;
    background-color: var(--paper);
  }

  .nav-breadcrumbs {
    margin-bottom: 1.5rem;
  }

  .back-link {
    font-size: 0.8125rem;
    color: var(--graphite);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--vermilion);
  }

  .detail-header {
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .header-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .sheet-id {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--ink);
  }

  .notice-tag {
    font-size: 0.6875rem;
    color: var(--graphite);
  }

  .usecase-heading {
    font-size: 2.5rem;
    line-height: 1.2;
    color: var(--ink);
  }

  .usecase-lead {
    font-size: 1.125rem;
    color: var(--graphite);
    max-width: 800px;
    line-height: 1.5;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 900px) {
    .detail-grid {
      grid-template-columns: 1.8fr 1fr;
    }
  }

  .content-col {
    display: flex;
    flex-direction: column;
  }

  .prose-body {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--graphite);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .prose-body :global(h3) {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink);
    margin-top: 1rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.35rem;
  }

  .prose-body :global(p) {
    margin-bottom: 0.75rem;
  }

  .prose-body :global(ol),
  .prose-body :global(ul) {
    margin-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .sidebar-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-left: 0;
  }

  @media (min-width: 900px) {
    .sidebar-col {
      padding-left: 2rem;
    }
  }

  .spec-sidebar-card,
  .failure-card {
    background-color: var(--paper);
  }

  .card-header {
    padding: 0.75rem 1rem;
    background-color: var(--paper-shade);
  }

  .card-title {
    color: var(--ink);
  }

  .card-body {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background-color: var(--paper);
  }

  .param-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-top: 0.75rem;
  }

  .param-group:first-child {
    padding-top: 0;
  }

  .param-label {
    color: var(--graphite);
  }

  .param-value {
    font-size: 0.875rem;
    color: var(--ink);
    font-weight: 500;
  }

  .param-basis {
    font-size: 0.75rem;
    color: var(--graphite);
    line-height: 1.4;
  }

  .param-note {
    font-size: 0.75rem;
    color: var(--graphite);
  }

  .download-btn {
    font-size: 0.75rem;
    color: var(--vermilion);
    text-decoration: underline;
  }

  .failure-list {
    list-style: none;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .failure-item {
    font-size: 0.75rem;
    color: var(--ink);
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    line-height: 1.4;
  }

  .warn-bullet {
    color: var(--vermilion);
  }
</style>
