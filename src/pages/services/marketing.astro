---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FramedSlot from "../../components/FramedSlot.astro";
import Stamp from "../../components/Stamp.astro";
---

<BaseLayout
  title="Marketing Operations Specification | Protorev Digital"
  description="Data pipelines connecting public web forms directly to internal operational data stores with bot mitigation."
  sheetNumber="02"
  totalSheets="06"
  sheetTitle="SERVICE SPECIFICATION: MARKETING OPERATIONS"
>
  <article class="service-sheet hairline-bottom">
    <div class="sheet-container">
      <div class="spec-header hairline-bottom">
        <div class="badge-row">
          <span class="sheet-tag mono">SHEET 02 / CAP03</span>
          <Stamp text="ACTIVE SPECIFICATION" variant="draft" />
        </div>
        <h1 class="spec-title">
          Digital Marketing <em>Operations</em>
        </h1>
        <p class="spec-summary">
          Data pipelines connecting public web forms directly to internal operational data stores.
        </p>
      </div>

      <div class="spec-body-grid">
        <div class="spec-main-col">
          <div class="spec-section">
            <h2 class="section-title label-mono">SCOPE OVERVIEW</h2>
            <p class="body-text">
              We design operational ingestion pathways that route customer inquiries directly from web interfaces into designated databases and CRM environments. Our focus is data integrity, automated spam rejection, and transparent operational visibility without leaky client scripts.
            </p>
          </div>

          <div class="spec-section hairline-top">
            <h2 class="section-title label-mono">DELIVERABLES INCLUDED</h2>
            <ul class="spec-list">
              <li class="spec-list-item">
                <span class="bullet mono">•</span>
                <span>Secure webhook event handlers with multi layer bot mitigation and token validation</span>
              </li>
              <li class="spec-list-item">
                <span class="bullet mono">•</span>
                <span>Multi source record normalization, schema mapping, and automated sanitization</span>
              </li>
              <li class="spec-list-item">
                <span class="bullet mono">•</span>
                <span>Operational event tracking and pipeline synchronization across distributed storage</span>
              </li>
              <li class="spec-list-item">
                <span class="bullet mono">•</span>
                <span>Audit logging and dead letter retry queues for zero loss data transport</span>
              </li>
            </ul>
          </div>

          <div class="spec-section hairline-top">
            <h2 class="section-title label-mono">TECHNICAL SPECIFICATIONS</h2>
            <div class="params-table-wrap ink-border">
              <table class="params-table">
                <tbody>
                  <tr>
                    <td class="param-key mono">INGRESS PROTOCOL</td>
                    <td class="param-val mono">HTTP POST delivering JSON payload with cryptographic headers</td>
                  </tr>
                  <tr>
                    <td class="param-key mono">BOT MITIGATION</td>
                    <td class="param-val mono">Cloudflare Turnstile verification and hidden honeypot validation</td>
                  </tr>
                  <tr>
                    <td class="param-key mono">DATA PRIVACY</td>
                    <td class="param-val mono">Mandatory explicit consent capture compliant with DPDP and GDPR</td>
                  </tr>
                  <tr>
                    <td class="param-key mono">AUDIT STORAGE</td>
                    <td class="param-val mono">Relational database or structured audit append log</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <aside class="spec-sidebar-col hairline-left">
          <div class="sidebar-slot">
            <FramedSlot slotId="CAP_MKTG_SPEC" ratio="1:1" label="Ingress Pipeline Schematic" />
          </div>

          <div class="sidebar-box hairline-top">
            <span class="box-label label-mono">ENGAGEMENT MODEL</span>
            <p class="box-text">
              Implemented alongside form builds or deployed as a standalone operational data bridge.
            </p>
            <a href="/contact" class="btn btn-primary cta-btn">
              Initiate Project Enquiry
            </a>
          </div>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .service-sheet {
    padding: 3rem 0;
    background-color: var(--paper);
  }

  .spec-header {
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
  }

  .badge-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .sheet-tag {
    font-size: 0.75rem;
    color: var(--graphite);
    letter-spacing: 0.08em;
  }

  .spec-title {
    font-size: 2.5rem;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: var(--ink);
  }

  .spec-summary {
    font-size: 1.125rem;
    color: var(--graphite);
    max-width: 800px;
    line-height: 1.6;
  }

  .spec-body-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 900px) {
    .spec-body-grid {
      grid-template-columns: 1.8fr 1fr;
    }
  }

  .spec-main-col {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .spec-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1.5rem;
  }

  .spec-section:first-child {
    padding-top: 0;
  }

  .section-title {
    color: var(--graphite);
  }

  .body-text {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--graphite);
  }

  .spec-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .spec-list-item {
    font-size: 0.9375rem;
    color: var(--ink);
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    line-height: 1.5;
  }

  .bullet {
    color: var(--graphite);
  }

  .params-table-wrap {
    overflow-x: auto;
    background-color: var(--paper-shade);
  }

  .params-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8125rem;
  }

  .params-table td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .params-table tr:last-child td {
    border-bottom: none;
  }

  .param-key {
    width: 35%;
    color: var(--graphite);
    border-right: 1px solid var(--rule);
  }

  .param-val {
    color: var(--ink);
    font-weight: 500;
  }

  .spec-sidebar-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-left: 0;
  }

  @media (min-width: 900px) {
    .spec-sidebar-col {
      padding-left: 2rem;
    }
  }

  .sidebar-box {
    padding: 1.5rem;
    background-color: var(--paper-shade);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .box-label {
    color: var(--graphite);
  }

  .box-text {
    font-size: 0.875rem;
    color: var(--graphite);
    line-height: 1.5;
  }

  .cta-btn {
    width: 100%;
  }
</style>
